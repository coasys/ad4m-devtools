{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "ad4mDir",
      "type": "promptString",
      "description": "AD4M repo path",
      "default": "${workspaceFolder}/../ad4m"
    },
    {
      "id": "fluxDir",
      "type": "promptString",
      "description": "Flux repo path",
      "default": "${workspaceFolder}/../flux"
    },
    {
      "id": "seedFile",
      "type": "promptString",
      "description": "Seed JSON file path (or leave empty for no seed)",
      "default": ""
    },
    {
      "id": "gqlPort",
      "type": "promptString",
      "description": "Executor port",
      "default": "12000"
    },
    {
      "id": "fluxPort",
      "type": "promptString",
      "description": "Flux preview port",
      "default": "3030"
    },
    {
      "id": "adminCredential",
      "type": "promptString",
      "description": "Admin credential",
      "default": "test123"
    },
    {
      "id": "weDir",
      "type": "promptString",
      "description": "WE repo path",
      "default": "${workspaceFolder}/../we"
    },
    {
      "id": "wePort",
      "type": "promptString",
      "description": "WE preview port",
      "default": "3000"
    },
    {
      "id": "whisperModel",
      "type": "pickString",
      "description": "Whisper model variant",
      "options": [
        "whisper_tiny_quantized",
        "whisper_tiny",
        "whisper_small",
        "whisper_small_en",
        "whisper_medium_en",
        "whisper_distil_large_v3",
        "whisper_large_v3_turbo_quantized"
      ],
      "default": "whisper_small"
    },
    {
      "id": "channelCount",
      "type": "promptString",
      "description": "Number of channels to create",
      "default": "2"
    },
    {
      "id": "messageCount",
      "type": "promptString",
      "description": "Messages per channel",
      "default": "10"
    }
  ],
  "tasks": [
    {
      "label": "AD4M + Flux: Full Rebuild (SDK + Executor + Flux)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-rebuild.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--executor"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Builds: core → connect → hooks → executor (Rust) → Flux"
    },
    {
      "label": "AD4M + Flux: Rebuild SDK + Flux (no executor)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-rebuild.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Builds: core → connect → hooks → Flux (skips Rust executor)"
    },
    {
      "label": "AD4M + Flux: Rebuild SDK Only",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-rebuild.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Builds: core → connect → hooks (no Flux)"
    },
    {
      "label": "AD4M + Flux: Launch (Fresh + Flux Mock Seed + Auth)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--generate-seed",
        "--fresh",
        "--headless-auth"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → generate mock community/channels/messages → Flux → browser auth"
    },
    {
      "label": "AD4M + Flux: Launch Dev (Fresh + Mock Seed + Auth)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--generate-seed",
        "--fresh",
        "--dev",
        "--headless-auth"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Like Mock Seed + Auth but runs vite dev (HMR + full sourcemaps in stack traces)"
    },
    {
      "label": "AD4M + Flux: Launch (Fresh + Seed + Auth)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--seed", "${input:seedFile}",
        "--fresh",
        "--headless-auth"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → executor (multi-user) → create user → seed → Flux → browser auth"
    },
    {
      "label": "AD4M + Flux: Launch (Fresh + Seed, Manual Login)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--seed", "${input:seedFile}",
        "--fresh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → executor (multi-user) → create user → seed → Flux (login manually)"
    },
    {
      "label": "AD4M + Flux: Launch (Resume, No Seed)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--flux", "${input:fluxDir}",
        "--no-seed"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Resume existing data → executor (multi-user) → Flux (no re-seed)"
    },
    {
      "label": "AD4M + Flux: Launch Executor Only (Fresh + Seed)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--seed", "${input:seedFile}",
        "--fresh",
        "--no-flux"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Executor only in multi-user mode, no Flux serve"
    },
    {
      "label": "AD4M: Browser Auth (Multi-User JWT)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-flux-browser-auth.sh",
      "args": [
        "--executor-url", "http://127.0.0.1:${input:gqlPort}",
        "--flux-url", "http://localhost:${input:fluxPort}",
        "--flux-dir", "${input:fluxDir}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Create user, login via WS RPC, inject JWT into browser, create Flux profile"
    },
    {
      "label": "AD4M: Seed Perspective",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/ad4m-perspective-tool.py",
        "--url", "ws://127.0.0.1:${input:gqlPort}/api/v1/ws",
        "--auth", "${input:adminCredential}",
        "import",
        "${input:seedFile}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Import a JSON perspective snapshot into the running executor"
    },
    {
      "label": "AD4M: Type Check (ts-rs vs SDK)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-type-check.sh",
      "args": [
        "--repo", "${input:ad4mDir}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Verify ts-rs generated types match SDK expectations"
    },
    {
      "label": "AD4M: Setup Transcription Model",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-transcription-setup.sh",
      "args": [
        "--model", "${input:whisperModel}",
        "--port", "${input:gqlPort}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Register Whisper model + pre-download weights into running executor"
    },
    {
      "label": "AD4M: Setup Transcription Model (no preload)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-transcription-setup.sh",
      "args": [
        "--model", "${input:whisperModel}",
        "--port", "${input:gqlPort}",
        "--no-preload"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Register Whisper model only (download happens on first use)"
    },
    {
      "label": "AD4M: Setup Both Transcription Models (Flux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "${workspaceFolder}/scripts/ad4m-transcription-setup.sh --model whisper_small --port ${input:gqlPort} && ${workspaceFolder}/scripts/ad4m-transcription-setup.sh --model whisper_tiny_quantized --port ${input:gqlPort}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Register both Whisper + Whisper tiny quantized (required by Flux)"
    },
    {
      "label": "AD4M + WE: Launch (Fresh + Auth)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-we-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--we", "${input:weDir}",
        "--fresh",
        "--headless-auth"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → executor (multi-user) → create user → WE (build+preview) → browser auth"
    },
    {
      "label": "AD4M + WE: Launch (Fresh, Manual Login)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-we-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--we", "${input:weDir}",
        "--fresh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → executor (multi-user) → create user → WE (login manually)"
    },
    {
      "label": "AD4M + WE: Launch Dev (Fresh + Auth)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-we-launch.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--we", "${input:weDir}",
        "--fresh",
        "--headless-auth",
        "--dev"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Kill existing → fresh data → executor (multi-user) → create user → WE (vite dev with HMR) → browser auth"
    },
    {
      "label": "AD4M: Kill All (executor + Flux/WE tmux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "tmux kill-session -t ad4m 2>/dev/null; tmux kill-session -t flux 2>/dev/null; tmux kill-session -t we 2>/dev/null; pkill -9 -f ad4m-executor 2>/dev/null; echo '✓ All AD4M processes stopped'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Kill executor, Flux, WE, and tmux sessions"
    },
    {
      "label": "AD4M: Tail Executor Logs",
      "type": "shell",
      "command": "tail",
      "args": ["-f", "/tmp/ad4m-executor.log"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Tail the executor log file (useful for security codes)"
    },
    {
      "label": "Tauri: Build & Run AD4M App (Release)",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "-C",
        "${input:ad4mDir}/ui",
        "tauri",
        "dev",
        "--release"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Build and run Tauri ad4m launcher app (release mode for ARM64 compatibility)"
    },
    {
      "label": "Flux: Dev Mode",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "-C",
        "${input:fluxDir}",
        "dev"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Start Flux dev server with hot module reload"
    },
    {
      "label": "WE: Dev Mode",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "-C",
        "${input:weDir}",
        "dev"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Start WE dev server with hot module reload"
    },
    {
      "label": "AD4M: Populate Links (Flux Channels + Messages)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-populate-links.sh",
      "args": [
        "--channels", "${input:channelCount}",
        "--messages", "${input:messageCount}",
        "--port", "${input:gqlPort}",
        "--auth", "${input:adminCredential}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Generate SHACL-compliant Channel/Message links into a running executor"
    }
  ]
}
