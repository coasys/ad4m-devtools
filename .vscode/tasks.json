{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "ad4mDir",
      "type": "promptString",
      "description": "AD4M repo path",
      "default": "${workspaceFolder}/../ad4m"
    },
    {
      "id": "seedFile",
      "type": "promptString",
      "description": "Seed JSON file path (or leave empty for no seed)",
      "default": ""
    },
    {
      "id": "gqlPort",
      "type": "promptString",
      "description": "Executor port",
      "default": "12000"
    },
    {
      "id": "adminCredential",
      "type": "promptString",
      "description": "Admin credential",
      "default": "test123"
    },
    {
      "id": "weDir",
      "type": "promptString",
      "description": "WE repo path",
      "default": "${workspaceFolder}/../we"
    },
    {
      "id": "whisperModel",
      "type": "pickString",
      "description": "Whisper model variant",
      "options": [
        "whisper_tiny_quantized",
        "whisper_tiny",
        "whisper_small",
        "whisper_small_en",
        "whisper_medium_en",
        "whisper_distil_large_v3",
        "whisper_large_v3_turbo_quantized"
      ],
      "default": "whisper_small"
    },
    {
      "id": "channelCount",
      "type": "promptString",
      "description": "Number of channels to create",
      "default": "5"
    },
    {
      "id": "messageCount",
      "type": "promptString",
      "description": "Messages per channel",
      "default": "10000"
    }
  ],
  "tasks": [
    {
      "label": "AD4M: Seed Perspective",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/ad4m-perspective-tool.py",
        "--url", "ws://127.0.0.1:${input:gqlPort}/api/v1/ws",
        "--auth", "${input:adminCredential}",
        "import",
        "${input:seedFile}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Import a JSON perspective snapshot into the running executor"
    },
    {
      "label": "AD4M: Type Check (ts-rs vs SDK)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-type-check.sh",
      "args": [
        "--repo", "${input:ad4mDir}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Verify ts-rs generated types match SDK expectations"
    },
    {
      "label": "AD4M: Setup Transcription Model",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-transcription-setup.sh",
      "args": [
        "--model", "${input:whisperModel}",
        "--port", "${input:gqlPort}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Register Whisper model + pre-download weights into running executor"
    },
    {
      "label": "AD4M: Setup Transcription Model (no preload)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-transcription-setup.sh",
      "args": [
        "--model", "${input:whisperModel}",
        "--port", "${input:gqlPort}",
        "--no-preload"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Register Whisper model only (download happens on first use)"
    },
    {
      "label": "AD4M: Integration Tests (executor RPC)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-integration-test.sh",
      "args": [
        "--ad4m", "${input:ad4mDir}",
        "--port", "4000"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Fresh executor → generate agent → run WS-RPC test suite (perspectives, SPARQL, modelQuery, evaluateGetters) → tear down"
    },
    {
      "label": "Tauri: Build & Run AD4M App (Release)",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "-C",
        "${input:ad4mDir}/ui",
        "tauri",
        "dev",
        "--release"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Build and run Tauri ad4m launcher app (release mode for ARM64 compatibility)"
    },
    {
      "label": "WE: Dev Mode",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "-C",
        "${input:weDir}",
        "dev"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Start WE dev server with hot module reload"
    },
    {
      "label": "AD4M: Populate Links (Flux Channels + Messages)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ad4m-populate-links.sh",
      "args": [
        "--channels", "${input:channelCount}",
        "--messages", "${input:messageCount}",
        "--port", "${input:gqlPort}",
        "--auth", "${input:adminCredential}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Generate SHACL-compliant Channel/Message links into a running executor"
    }
  ]
}
